{
  "name": "files-introduction-for-ai",
  "version": "0.1.1",
  "description": "AI code file indexer CLI with git incremental/full indexing",
  "author": "todd.wang <todd.wang@itodd.wang>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adouwt/files-introduction-for-ai.git"
  },
  "bugs": {
    "url": "https://github.com/adouwt/files-introduction-for-ai/issues"
  },
  "homepage": "https://github.com/adouwt/files-introduction-for-ai#readme",
  "type": "module",
  "keywords": [
    "ai",
    "code-indexer",
    "git",
    "incremental-index",
    "full-index",
    "qwen",
    "llm",
    "code-analysis",
    "codebase",
    "pre-commit"
  ],
  "bin": {
    "ai-file-indexer": "bin/cli.js"
  },
  "files": [
    "bin",
    "scripts",
    "templates",
    "README.md"
  ],
  "publishConfig": {
    "registry": "http://npm.itodd.wang/"
  },
  "scripts": {
    "ai:index:full": "node bin/cli.js index --full",
    "ai:index:incremental": "node bin/cli.js index --incremental",
    "ai:hooks:setup": "node bin/cli.js hooks setup",
    "ai:init": "node bin/cli.js init",
    "check": "node --check bin/cli.js && node --check scripts/ai-indexer.js && node --check scripts/setup-hooks.js && node --check scripts/init-project.js"
  }
}
