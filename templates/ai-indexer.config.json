{
  "includeExtensions": ["js", "ts", "tsx", "vue", "py", "java", "go", "md"],
  "excludeGlobs": [
    "node_modules/",
    ".git/",
    "dist/",
    "build/",
    "coverage/",
    "vendor/",
    ".next/",
    "out/"
  ],
  "outputDir": ".ai",
  "jsonOutput": "file-index.json",
  "mdOutput": "file-index.md",
  "moduleMdOutput": "module-index.md",
  "moduleJsonOutput": "module-index.json",
  "llm": {
    "provider": "qwen",
    "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "model": "qwen-plus"
  },
  "maxFileCharsForLlm": 8000
}
